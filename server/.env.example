# Copy this file to .env and fill in real values. Never commit .env itself.

# MongoDB connection string — local instance or MongoDB Atlas
MONGO_URI=mongodb://127.0.0.1:27017/plantista

# Server port
PORT=5000

# Secret used to sign JWTs — use a long random string in production
JWT_SECRET=replace_with_a_long_random_string

# How long login tokens stay valid
JWT_EXPIRES_IN=7d

# Comma-separated list of origins allowed to call this API
CLIENT_ORIGIN=http://localhost:5173

# Optional: set NODE_ENV=production when deploying (hides error stack traces)
NODE_ENV=development

# Password for the seeded admin account (admin@plantista.com). Change it before deploying.
ADMIN_PASSWORD=change_me_before_deploying
